Bootstrap: docker
From: nvidia/cuda:12.9.0-base-ubuntu24.04

%files
    requirements.txt /requirements.txt
    stopred_prediction.py /opt/stopred/stopred_prediction.py
    network /opt/stopred/network
    config.py /opt/stopred/config.py
    utils /opt/stopred/utils
    # Add more as needed

%post
    # Install Python and build tools for compiling extensions
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev python3-pip \
        build-essential pkg-config curl && \
    rm -rf /var/lib/apt/lists/*

    # Create and set up venv
    python3.12 -m venv /opt/venv
    /opt/venv/bin/pip install --upgrade pip setuptools wheel
    /opt/venv/bin/pip install uv

    #
    VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH" uv pip install -r /requirements.txt

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=$VIRTUAL_ENV/bin:$PATH

%runscript
    cd /opt/stopred
    exec python3 stopred_prediction.py "$@"
